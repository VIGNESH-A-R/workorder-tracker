generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           Int    @id @default(autoincrement())
  username     String @unique
  passwordHash String
  fullName     String
  role         String
}

// Single-row table (upserted at id 1) — there's only ever one Jira connection
// for this demo. apiToken is stored in plaintext; see the comment in
// features/jira/jiraClient.js for the same caveat as the JWT secret.
model JiraCredential {
  id        Int      @id @default(autoincrement())
  siteUrl   String
  email     String
  apiToken  String
  // Cached from Jira's /myself at save time so /jira/projects can check
  // project role membership without a /myself round trip on every call.
  accountId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single-row table (upserted at id 1) — same pattern as JiraCredential, one
// GitHub connection for this demo. token is stored in plaintext, same
// tradeoff as JiraCredential.apiToken.
model GitHubCredential {
  id        Int      @id @default(autoincrement())
  owner     String
  repo      String
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Single-row table (upserted at id 1) — determines which connected provider
// (Jira or GitHub) the Issues, Ticket Optimization, and AI Analysis features
// read from.
model IntegrationSettings {
  id             Int    @id @default(autoincrement())
  activeProvider String @default("jira")
}
